-- Planned release: URLs become usable only after this tag has been published.
-- For local development use src/mac/start_simulator.sh (isolated local plugin).
local plugin_version = "v1"
local plugin_base = "https://github.com/labolado/solar2d-plugin-geometry2d/releases/download/"
    .. plugin_version .. "/"

settings =
{
    orientation =
    {
        default = "landscapeRight",
        supported = { "landscapeLeft", "landscapeRight" }
    },

    excludeFiles =
    {
        all = { ".DS_Store", "*.bak", "*.psd", ".git", ".gitignore", ".cache", "*.md" },
    },

    plugins =
    {
        ["plugin.geometry2d"] =
        {
            publisherId = "com.labolado",
            supportedPlatforms =
            {
                ["mac-sim"]    = { url = plugin_base .. "2025.3720-mac-sim.tgz" },
                ["android"]    = { url = plugin_base .. "2025.3720-android.tgz" },
                ["iphone"]     = { url = plugin_base .. "2025.3720-iphone.tgz" },
                ["iphone-sim"] = { url = plugin_base .. "2025.3720-iphone-sim.tgz" },
                ["win32-sim"]  = { url = plugin_base .. "2025.3720-win32-sim.tgz" },
                ["appletvos"]  = { url = plugin_base .. "2025.3720-appletvos.tgz" },
            }
        },
    }
}
